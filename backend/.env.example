NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/helpji
JWT_ACCESS_SECRET=your-secure-access-token-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=your-secure-refresh-token-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=12

# ── Cloudflare R2 Object Storage (S3-compatible) ───────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=helpji-files
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev

# ── Firebase Admin SDK (Google OAuth Verification) ─────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ── Google Maps API Key ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Razorpay Payment Gateway ───────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
PLATFORM_COMMISSION_PERCENT=0.10
